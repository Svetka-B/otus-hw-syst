upstream debug_backends {
    server 10.2.0.29:9000;
    server 10.2.0.29:9001;
    server 10.2.0.29:9002;
    server 10.2.0.29:9003;
}

server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://debug_backends;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}